# 이 파일을 복사해 .env.local 로 저장하고 실제 값을 채우세요. (.env.local은 git에 올라가지 않습니다)

# Supabase (프로젝트 설정 > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service role 키는 서버(API Route)에서만 사용 — NEXT_PUBLIC_ 접두사 붙이지 말 것
SUPABASE_SECRET_KEY=

# OpenAI — 반드시 서버(app/api/**)에서만 사용
OPENAI_API_KEY=
