# 이 파일을 복사해 .env.local 로 저장하고 실제 값을 채우세요. (.env.local은 git에 올라가지 않습니다)

# Supabase (프로젝트 설정 > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service role 키는 서버(API Route)에서만 사용 — NEXT_PUBLIC_ 접두사 붙이지 말 것
SUPABASE_SECRET_KEY=

# OpenAI — 반드시 서버(app/api/**)에서만 사용
OPENAI_API_KEY=

# 개발 환경에서 로그인 없이 쓸 학생 id. 로그인 화면이 없는 동안의 임시 장치이며
# 프로덕션에서는 무시된다. off 로 두면 개발 환경에서도 401 을 그대로 본다.
# DEV_STUDENT_ID=30000000-0000-4000-8000-000000000001

# AI 호출 차단 스위치. false 로 두면 학생 화면이 목업 칩 흐름으로 동작하고
# STT·대화 요청을 보내지 않는다. 화면 작업만 할 때 과금을 막는 용도.
# AI_ENABLED=false

# 학생 대화 모델 (미설정 시 gpt-4o-mini)
# CHAT_MODEL=gpt-4o-mini
# 음성 인식 모델 (미설정 시 gpt-4o-mini-transcribe)
# STT_MODEL=gpt-4o-mini-transcribe

# 아이템 추론 모델 (미설정 시 gpt-4.1-mini)
OPENAI_ITEM_MODEL=gpt-4.1-mini

# Optional model override for 3D assembly (falls back to OPENAI_ITEM_MODEL)
OPENAI_ITEM_ASSEMBLY_MODEL=gpt-4.1-mini

# Secret sent by a trusted cron/worker to process one queued item job
ITEM_WORKER_SECRET=replace-with-a-random-server-secret

# 선생님 agent(협진 챗봇) 모델 (미설정 시 gpt-4.1-mini)
OPENAI_AGENT_MODEL=gpt-4.1-mini
